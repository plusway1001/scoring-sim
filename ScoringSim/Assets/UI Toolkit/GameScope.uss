.unity-scroller--vertical,
.unity-scroll-view__vertical-scroller {
    width: 10px;
}

.unity-scroller--vertical .unity-scroller__low-button,
.unity-scroller--vertical .unity-scroller__high-button,
.unity-scroll-view__vertical-scroller .unity-scroller__low-button,
.unity-scroll-view__vertical-scroller .unity-scroller__high-button {
    display: none;
}

.unity-scroller--vertical .unity-base-slider__tracker,
.unity-scroll-view__vertical-scroller .unity-base-slider__tracker {
    background-color: rgba(255, 255, 255, 0.03);
    border-width: 0;
    border-radius: 999px;
    width: 4px;
    margin-left: 3px;
}

.unity-scroller--vertical .unity-base-slider__dragger,
.unity-scroll-view__vertical-scroller .unity-base-slider__dragger {
    background-color: rgba(255, 255, 255, 0.15);
    border-width: 0;
    border-radius: 999px;
    width: 4px;
}

.unity-scroller--vertical .unity-base-slider__dragger:hover,
.unity-scroll-view__vertical-scroller .unity-base-slider__dragger:hover {
    background-color: rgba(233, 69, 96, 0.6);
}

.page {
    --color-bg: rgb(47, 74, 99);
    --color-panel-bg: rgb(58, 83, 107);
    --color-border: rgb(94, 122, 150);
    --color-accent: rgb(93, 180, 221);
    --color-accent-dark: rgb(79, 169, 216);
    --color-text: rgb(255, 255, 255);
    --color-text-muted: rgb(210, 222, 232);
    --color-text-faint: rgb(147, 168, 186);
    --color-good: rgb(154, 214, 107);
    --color-good-dark: rgb(119, 184, 78);
    --color-mid: rgb(255, 209, 102);
    --color-bad: rgb(255, 122, 122);
    width: 1920px;
    height: 1080px;
    background-color: var(--color-bg);
    color: var(--color-text);
    overflow: hidden;
}

.hidden {
    display: none;
}

.navbar {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    height: 60px;
    padding-left: 32px;
    padding-right: 32px;
    border-bottom-width: 1px;
    border-bottom-color: var(--color-border);
    background-color: var(--color-bg);
}

.navbar__brand {
    font-size: 22px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: var(--color-text);
}

.navbar__brand-accent {
    color: var(--color-accent);
}

.navbar__links {
    flex-direction: row;
}

.navbar__link {
    font-size: 14px;
    -unity-font-style: bold;
    color: var(--color-text-muted);
    margin-left: 24px;
    -unity-text-align: middle-center;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.navbar__link--active {
    color: var(--color-accent);
    border-bottom-width: 2px;
    border-bottom-color: var(--color-accent);
}

.navbar__link--muted {
    color: var(--color-text-faint);
    font-size: 12px;
}

.back-btn {
    background-color: rgba(0, 0, 0, 0);
    border-width: 1px;
    border-color: var(--color-border);
    border-radius: 8px;
    color: var(--color-text-muted);
    padding: 6px 16px;
    font-size: 14px;
    margin-right: 16px;
}

.btn-primary {
    background-color: var(--color-accent);
    border-width: 0;
    border-radius: 10px;
    color: var(--color-text);
    -unity-font-style: bold;
    font-size: 18px;
    letter-spacing: 1px;
    padding: 18px;
    min-height: 56px;
    -unity-text-align: middle-center;
}

.btn-primary:hover {
    background-color: var(--color-accent-dark);
}

.btn-secondary:hover,
.btn-guest:hover,
.btn-toggle:hover,
.back-btn:hover,
.auth-tab:hover,
.tag:hover {
    border-color: rgb(127, 214, 255);
    background-color: rgba(127, 214, 255, 0.18);
    color: rgb(255, 255, 255);
}

.btn-success:hover {
    background-color: var(--color-good-dark);
}

.btn-secondary {
    background-color: rgba(0, 0, 0, 0);
    border-width: 1px;
    border-color: var(--color-border);
    border-radius: 8px;
    color: var(--color-text-muted);
    -unity-font-style: bold;
    font-size: 14px;
    letter-spacing: 1px;
    padding: 12px 28px;
    -unity-text-align: middle-center;
}

.btn-success {
    background-color: var(--color-good);
    border-width: 0;
    border-radius: 8px;
    color: rgb(10, 42, 26);
    -unity-font-style: bold;
    font-size: 14px;
    letter-spacing: 1px;
    padding: 12px 28px;
    -unity-text-align: middle-center;
}

.btn-guest {
    background-color: rgba(0, 0, 0, 0);
    border-width: 1px;
    border-color: var(--color-border);
    border-radius: 10px;
    color: var(--color-text-faint);
    font-size: 15px;
    letter-spacing: 1px;
    padding: 14px;
    min-height: 46px;
    -unity-text-align: middle-center;
}

.btn-toggle {
    background-color: rgba(0, 0, 0, 0);
    border-width: 1px;
    border-color: var(--color-border);
    border-radius: 8px;
    color: var(--color-text-muted);
    -unity-font-style: bold;
    font-size: 14px;
    letter-spacing: 1px;
    padding: 12px 24px;
    -unity-text-align: middle-center;
}

.btn-toggle--active {
    background-color: rgba(233, 69, 96, 0.13);
    border-color: var(--color-accent);
    color: var(--color-accent);
}

.btn-toggle--active-green {
    background-color: rgba(0, 229, 160, 0.13);
    border-color: var(--color-good);
    color: var(--color-good);
}

.center-page {
    flex-grow: 1;
    align-items: center;
    justify-content: flex-start;
    padding-top: 120px;
    padding-left: 24px;
    padding-right: 24px;
}

.auth-wrap {
    width: 620px;
}

.logo-block {
    align-items: center;
    margin-bottom: 40px;
}

.logo {
    font-size: 64px;
    -unity-font-style: bold;
    color: var(--color-text);
    letter-spacing: 3px;
}

.logo__accent {
    color: var(--color-accent);
}

.tagline {
    color: var(--color-text-muted);
    font-size: 18px;
    -unity-font-style: italic;
    margin-top: 8px;
}

.auth-card {
    background-color: var(--color-panel-bg);
    border-width: 1px;
    border-color: var(--color-border);
    border-radius: 20px;
    padding: 48px;
}

.auth-tabs {
    flex-direction: row;
    background-color: var(--color-panel-bg);
    border-radius: 8px;
    padding: 4px;
    margin-bottom: 28px;
}

.auth-tab {
    flex-grow: 1;
    border-radius: 6px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: var(--color-text-faint);
    -unity-font-style: bold;
    font-size: 14px;
    letter-spacing: 1px;
    padding: 8px 0;
    -unity-text-align: middle-center;
}

.auth-tab--active {
    background-color: var(--color-accent);
    color: var(--color-text);
}

.field {
    margin-bottom: 16px;
}

.field__label {
    font-size: 12px;
    color: var(--color-text-muted);
    letter-spacing: 1px;
    margin-bottom: 6px;
}

.field__input {
    background-color: var(--color-panel-bg);
    border-width: 1px;
    border-color: var(--color-border);
    border-radius: 10px;
    color: var(--color-text);
    font-size: 18px;
    padding: 14px 16px;
    min-height: 54px;
}

.field__input > TextInput,
.field__input .unity-text-field__input {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: var(--color-text);
}

.field__input:focus {
    border-color: var(--color-accent);
}

.error-box {
    color: var(--color-accent);
    background-color: rgba(233, 69, 96, 0.08);
    border-radius: 6px;
    font-size: 13px;
    padding: 8px 12px;
    margin-bottom: 12px;
    white-space: normal;
}

.hint-text {
    color: rgb(68, 68, 68);
    font-size: 12px;
    -unity-text-align: upper-center;
    margin-top: 16px;
}

.onboarding-wrap {
    width: 560px;
}

.onboarding-eyebrow {
    font-size: 13px;
    color: var(--color-text-muted);
    letter-spacing: 2px;
    margin-bottom: 8px;
}

.onboarding-title {
    font-size: 32px;
    -unity-font-style: bold;
    color: var(--color-text);
    margin-bottom: 16px;
}

.progress-row {
    flex-direction: row;
}

.progress-seg {
    flex-grow: 1;
    height: 3px;
    background-color: var(--color-border);
    border-radius: 2px;
    margin-right: 8px;
}

.progress-seg--active {
    background-color: var(--color-accent);
}

.step-card {
    background-color: var(--color-panel-bg);
    border-width: 1px;
    border-color: var(--color-border);
    border-radius: 16px;
    padding: 32px;
    min-height: 260px;
    margin-top: 20px;
}

.step-title {
    font-size: 22px;
    -unity-font-style: bold;
    color: var(--color-text);
    margin-bottom: 4px;
}

.step-sub {
    font-size: 14px;
    color: var(--color-text-muted);
    -unity-font-style: italic;
    margin-bottom: 24px;
    white-space: normal;
}

.step-nav-row {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 20px;
}

.step-nav-row > Button {
    margin-left: 12px;
}

.price-label {
    color: var(--color-text-muted);
    font-size: 13px;
    margin-bottom: 8px;
}

.themed-slider .unity-base-slider__tracker {
    background-color: var(--color-border);
    border-width: 0;
    border-radius: 10px;
    height: 6px;
}

.themed-slider__fill {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    background-color: var(--color-accent);
    border-radius: 10px;
}

.themed-slider .unity-base-slider__dragger {
    background-color: var(--color-text);
    border-width: 2px;
    border-color: var(--color-accent);
    border-radius: 10px;
    width: 16px;
    height: 16px;
    margin-top: -5px;
}

.section-label {
    font-size: 13px;
    color: var(--color-text-muted);
    margin-bottom: 8px;
    letter-spacing: 1px;
}

.tag-row {
    flex-direction: row;
    flex-wrap: wrap;
}

.tag {
    border-radius: 10px;
    border-width: 1px;
    border-color: rgb(51, 51, 51);
    background-color: rgba(0, 0, 0, 0);
    color: var(--color-text-muted);
    font-size: 12px;
    padding: 4px 10px;
    margin-right: 8px;
    margin-bottom: 8px;
    -unity-text-align: middle-center;
}

.tag--active {
    border-color: rgb(127, 214, 255);
    background-color: rgb(127, 214, 255);
    color: rgb(20, 35, 50);
}

.tag--community {
    border-color: var(--color-mid);
    background-color: rgba(245, 197, 24, 0.1);
    color: var(--color-mid);
}

.tag-submit-row {
    flex-direction: row;
    margin-bottom: 16px;
}

.tag-submit-row > TextField {
    flex-grow: 1;
    margin-right: 8px;
}

.tag-submit-row .unity-base-field__input {
    background-color: var(--color-panel-bg);
    border-width: 1px;
    border-color: var(--color-border);
    border-radius: 8px;
    padding: 2px 10px;
    min-height: 34px;
}

.tag-submit-row .unity-text-field__input {
    color: var(--color-text);
    font-size: 14px;
}

.score-badge-col {
    align-items: center;
}

.game-card .score-badge-col__label {
    font-size: 9px;
    color: var(--color-text);
    -unity-font-style: bold;
    letter-spacing: 1px;
    margin-bottom: 3px;
}

.score-badge {
    border-radius: 999px;
    border-width: 2px;
    align-items: center;
    justify-content: center;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}

.score-badge--sm {
    width: 40px;
    height: 40px;
    font-size: 13px;
}

.score-badge--md {
    width: 52px;
    height: 52px;
    font-size: 18px;
    border-width: 2px;
}

.score-badge--lg {
    width: 72px;
    height: 72px;
    font-size: 30px;
    border-width: 3px;
}

.score-badge--good {
    border-color: var(--color-good);
    color: var(--color-good);
    background-color: rgba(0, 229, 160, 0.08);
}

.score-badge--mid {
    border-color: var(--color-mid);
    color: var(--color-mid);
    background-color: rgba(245, 197, 24, 0.08);
}

.score-badge--bad {
    border-color: var(--color-bad);
    color: var(--color-bad);
    background-color: rgba(224, 92, 92, 0.08);
}

.score-badge--na {
    border-color: var(--color-text-faint);
    color: var(--color-text-faint);
    background-color: rgb(26, 26, 26);
}

.page-content {
    padding: 32px;
}

.page-content-inner {
    max-width: 900px;
    width: 100%;
    align-self: center;
}

.hero-panel {
    background-color: rgb(22, 33, 62);
    border-width: 1px;
    border-color: rgb(26, 42, 78);
    border-radius: 12px;
    padding: 24px 28px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 28px;
}

.hero-panel__eyebrow {
    font-size: 13px;
    color: var(--color-text-muted);
    letter-spacing: 2px;
}

.hero-panel__name {
    font-size: 28px;
    -unity-font-style: bold;
    color: var(--color-text);
}

.hero-panel__sub {
    font-size: 13px;
    color: var(--color-text-muted);
    margin-top: 4px;
}

.hero-stats-row {
    flex-direction: row;
}

.hero-stat {
    align-items: center;
    margin-left: 24px;
}

.hero-stat__value {
    font-size: 28px;
    -unity-font-style: bold;
}

.hero-stat__value--good {
    color: var(--color-good);
}

.hero-stat__value--accent {
    color: var(--color-accent);
}

.hero-stat__label {
    font-size: 11px;
    color: var(--color-text-muted);
    letter-spacing: 1px;
}

.filters-row {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin-bottom: 24px;
}

.filters-row > * {
    margin-right: 12px;
    margin-bottom: 8px;
}

.search-field {
    min-width: 200px;
}

.field-placeholder {
    position: absolute;
    left: 10px;
    right: 10px;
    top: 0;
    bottom: 0;
    color: var(--color-text-faint);
    font-size: 13px;
    -unity-text-align: middle-left;
}

.search-field .unity-base-field__input {
    background-color: var(--color-panel-bg);
    border-width: 1px;
    border-color: var(--color-border);
    border-radius: 8px;
    padding: 2px 10px;
    min-height: 34px;
}

.search-field .unity-text-field__input,
.search-field .unity-base-field__input > TextInput {
    color: var(--color-text);
    font-size: 13px;
    -unity-text-align: middle-left;
}

.search-field .unity-base-field__input:focus,
.tag-submit-row .unity-base-field__input:focus {
    border-color: var(--color-accent);
}

.themed-dropdown {
    position: relative;
    min-width: 160px;
}

.themed-dropdown__trigger {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    background-color: var(--color-panel-bg);
    border-width: 1px;
    border-color: var(--color-border);
    border-radius: 8px;
    padding: 8px 12px;
    min-height: 34px;
}

.themed-dropdown--open > .themed-dropdown__trigger {
    border-color: var(--color-accent);
}

.themed-dropdown__trigger:hover {
    border-color: var(--color-accent);
}

.themed-dropdown__label {
    color: var(--color-text);
    font-size: 13px;
    flex-grow: 1;
}

.themed-dropdown__arrow {
    width: 0;
    height: 0;
    margin-left: 8px;
    border-left-width: 4px;
    border-right-width: 4px;
    border-top-width: 5px;
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: var(--color-text-muted);
}

.themed-dropdown--open .themed-dropdown__arrow {
    border-top-color: var(--color-accent);
}

.themed-dropdown__menu {
    background-color: var(--color-panel-bg);
    border-width: 1px;
    border-color: var(--color-border);
    border-radius: 8px;
    max-height: 260px;
    padding: 4px;
}

.themed-dropdown__menu .unity-scroll-view__content-container {
    flex-grow: 1;
}

.themed-dropdown__option {
    padding: 8px 10px;
    border-radius: 6px;
}

.themed-dropdown__option:hover {
    background-color: rgba(255, 255, 255, 0.06);
}

.themed-dropdown__option--selected {
    background-color: rgba(233, 69, 96, 0.13);
}

.themed-dropdown__option-text {
    color: var(--color-text);
    font-size: 13px;
}

.themed-dropdown__option--selected .themed-dropdown__option-text {
    color: var(--color-accent);
}

.results-count {
    color: var(--color-text-faint);
    font-size: 13px;
    flex-grow: 1;
    -unity-text-align: middle-right;
}

.legend-row {
    flex-direction: row;
    margin-bottom: 20px;
}

.legend-item {
    flex-direction: row;
    align-items: center;
    margin-right: 16px;
}

.legend-dot {
    width: 20px;
    height: 20px;
    border-radius: 999px;
    border-width: 2px;
    margin-right: 6px;
}

.legend-dot--general {
    border-color: var(--color-text-muted);
}

.legend-dot--user {
    border-color: var(--color-accent);
    background-color: rgba(233, 69, 96, 0.08);
}

.legend-label {
    font-size: 12px;
    color: var(--color-text-muted);
}

.legend-label--accent {
    color: var(--color-accent);
}

.empty-state {
    -unity-text-align: middle-center;
    color: var(--color-text-faint);
    font-size: 16px;
    padding: 60px 0;
}

.grid {
    flex-direction: row;
    flex-wrap: wrap;
}

.game-card {
    width: 220px;
    height: 285px;

    background-color: var(--color-panel-bg);
    border-width: 1px;
    border-color: var(--color-border);
    border-radius: 12px;

    margin-right: 16px;
    margin-bottom: 16px;
    flex-direction: column;
    overflow: hidden;
}

.game-card:hover {
    border-color: var(--color-accent);
    background-color: rgb(30, 30, 46);
}

.game-card__body {
    flex-grow: 1;
    height: auto;
    padding: 20px 20px 10px 20px;
}

.game-card__top-row {
    height: 64px;
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 10px;
}

.game-card__icon {
    font-size: 34px;
    width: 64px;
    height: 64px;
    border-radius: 8px;
    -unity-text-align: middle-center;
}

.game-card__scores {
    flex-direction: row;
}

.game-card__scores > .score-badge-col {
    margin-left: 8px;
}

.game-card__title {
    height: 36px;
    font-size: 15px;
    -unity-font-style: bold;
    color: var(--color-text);
    margin-bottom: 4px;
    white-space: normal;
}

.game-card__meta {
    height: 20px;
    font-size: 12px;
    color: var(--color-text-muted);
    margin-bottom: 8px;
}

.game-card__tags {
    height: 52px;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-start;
    align-content: flex-start;
    justify-content: flex-start;
    overflow: hidden;
}

.game-card__chip {
    font-size: 11px;
    padding: 2px 8px;
    margin-right: 4px;
    margin-bottom: 4px;
    white-space: nowrap;
}

.game-card__chip--accent {
    background-color: rgba(233, 69, 96, 0.07);
    color: var(--color-accent);
}

.game-card__wishlist {
    height: 44px;
    min-height: 44px;
    flex-direction: row;
    align-items: center;
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.08);
    padding: 8px 20px;
    font-size: 12px;
    -unity-font-style: bold;
    color: var(--color-text-faint);
}


.game-card__wishlist--active {
    font-size: 12px;
    -unity-font-style: bold;
    background-color: rgb(251, 160, 129);
    color: rgb(36, 52, 71);
}

.game-card__wishlist--active .game-card__heart {
   color: rgb(36, 52, 71);
}

.game-card__heart {
    margin-right: 6px;
}

.detail-hero {
    position: relative;
    overflow: hidden;
    padding: 48px 32px 32px 32px;
    flex-direction: row;
    flex-wrap: wrap;
}

.detail-hero__background {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    unity-background-scale-mode: scale-and-crop;
}

.detail-hero__icon {
    font-size: 64px;
    width: 120px;
    height: 120px;
    border-radius: 16px;
    -unity-text-align: middle-center;
    margin-right: 32px;
    margin-bottom: 16px;
}

.detail-hero__info {
    flex-grow: 1;
    min-width: 260px;
    margin-right: 32px;
}

.detail-hero__eyebrow {
    font-size: 11px;
    color: var(--color-text-muted);
    letter-spacing: 2px;
}

.detail-hero__title {
    font-size: 38px;
    -unity-font-style: bold;
    color: var(--color-text);
    margin-bottom: 8px;
    white-space: normal;
}

.detail-hero__byline {
    font-size: 14px;
    color: var(--color-text-muted);
    margin-bottom: 16px;
}

.detail-hero__tags {
    flex-direction: row;
    flex-wrap: wrap;
}

.detail-hero__scores {
    flex-direction: row;
}

.detail-hero__scores > .score-badge-col {
    margin-right: 20px;
}

.detail-body {
    width: 760px;
    max-width: 760px;
    padding: 32px 0;
    align-self: center;
}

.stats-columns {
    flex-direction: row;
    width: 100%;
    align-items: stretch;
    margin-bottom: 16px;
}

.stats-columns > .panel {
    flex-grow: 1;
    flex-basis: 0;
    height: 360px;
    margin-top: 0;
    margin-bottom: 0;
    align-self: stretch;
}

.panel {
    width: 100%;
    background-color: var(--color-panel-bg);
    border-width: 1px;
    border-color: var(--color-border);
    border-radius: 12px;
    padding: 24px;
    margin-bottom: 24px;
}

.panel__title {
    font-size: 16px;
    -unity-font-style: bold;
    color: var(--color-accent);
    letter-spacing: 1px;
    margin-bottom: 16px;
}

.stat-row {
    margin-bottom: 12px;
}

.stat-row__labels {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 4px;
}

.stat-row__label {
    font-size: 13px;
    color: var(--color-text-muted);
}

.stat-row__weight {
    color: var(--color-text-faint);
}

.stat-row__value {
    font-size: 13px;
    color: var(--color-text);
    -unity-font-style: bold;
}

.stat-row__bar-bg {
    height: 4px;
    background-color: var(--color-border);
    border-radius: 2px;
}

.stat-row__bar-fill {
    height: 4px;
    background-color: rgb(15, 52, 96);
    border-radius: 2px;
}

.panel-total-row {
    flex-direction: row;
    justify-content: space-between;
    border-top-width: 1px;
    border-top-color: var(--color-border);
    padding-top: 12px;
    margin-top: 8px;
    -unity-font-style: bold;
}

.panel-total-row--accent {
    border-top-color: var(--color-accent);
}

.panel-total-row__value {
    font-size: 20px;
}

.modifier-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 8px 0;
    border-bottom-width: 1px;
    border-bottom-color: var(--color-border);
}

.modifier-row__label {
    font-size: 13px;
    color: var(--color-text-muted);
}

.modifier-row__value {
    font-size: 14px;
    -unity-font-style: bold;
}

.modifier-row__value--good {
    color: var(--color-good);
}

.modifier-row__value--warn {
    color: var(--color-mid);
}

.modifier-row__value--bad {
    color: var(--color-accent);
}

.modifier-row__value--muted {
    color: var(--color-text-faint);
}

.action-row {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 24px;
}

.action-row > Button {
    margin-right: 12px;
}

.rating-row {
    flex-direction: row;
    flex-wrap: wrap;
}

.rating-btn {
    width: 40px;
    height: 40px;
    border-radius: 8px;
    border-width: 2px;
    border-color: var(--color-border);
    background-color: rgba(0, 0, 0, 0);
    color: var(--color-text-faint);
    -unity-font-style: bold;
    font-size: 15px;
    margin-right: 6px;
    -unity-text-align: middle-center;
}

.rating-btn:hover {
    border-color: var(--color-mid);
    color: var(--color-mid);
}

.rating-btn--active {
    border-color: var(--color-mid);
    background-color: rgba(245, 197, 24, 0.13);
    color: var(--color-mid);
}

.rating-confirm {
    color: var(--color-good);
    font-size: 13px;
    margin-top: 12px;
}

.profile-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 32px;
}

.profile-username {
    font-size: 36px;
    -unity-font-style: bold;
    color: var(--color-text);
}

.profile-substats {
    color: var(--color-text-muted);
    font-size: 14px;
}

.summary-grid {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 28px;
}

.summary-card {
    width: 48%;
    background-color: var(--color-panel-bg);
    border-width: 1px;
    border-color: var(--color-border);
    border-radius: 12px;
    padding: 20px;
    margin-right: 2%;
    margin-bottom: 16px;
}

.summary-card__label {
    font-size: 12px;
    color: var(--color-text-muted);
    letter-spacing: 1px;
    margin-bottom: 12px;
}

.summary-tags {
    flex-direction: row;
    flex-wrap: wrap;
}

.summary-chip {
    border-radius: 20px;
    border-width: 1px;
    font-size: 12px;
    padding: 3px 10px;
    margin-right: 6px;
    margin-bottom: 6px;
}

.summary-empty {
    color: rgb(68, 68, 68);
    font-size: 13px;
}

.section-heading {
    font-size: 20px;
    -unity-font-style: bold;
    margin-bottom: 16px;
    flex-direction: row;
    align-items: center;
}

.section-heading__icon {
    color: var(--color-accent);
    margin-right: 10px;
}

.reco-grid {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 28px;
}

.reco-card {
    width: 200px;
    background-color: var(--color-panel-bg);
    border-width: 1px;
    border-color: var(--color-border);
    border-radius: 10px;
    padding: 16px;
    margin-right: 12px;
    margin-bottom: 12px;
    flex-direction: row;
    align-items: center;
}

.reco-card__icon {
    font-size: 26px;
    margin-right: 12px;
}

.reco-card__title {
    font-size: 14px;
    -unity-font-style: bold;
    color: var(--color-text);
}

.reco-card__genre {
    font-size: 11px;
    color: var(--color-text-muted);
}

.reco-card__score {
    font-size: 16px;
    -unity-font-style: bold;
    color: var(--color-good);
    margin-top: 2px;
}

.list-section {
    margin-bottom: 24px;
}

.list-section__title {
    font-size: 18px;
    -unity-font-style: bold;
    margin-bottom: 12px;
}

.list-section__title--wishlist {
    color: var(--color-accent);
}

.list-section__title--completed {
    color: var(--color-good);
}

.list-chips-row {
    flex-direction: row;
    flex-wrap: wrap;
}

.list-chip {
    background-color: var(--color-panel-bg);
    border-width: 1px;
    border-radius: 8px;
    padding: 8px 16px;
    margin-right: 10px;
    margin-bottom: 10px;
    flex-direction: row;
    align-items: center;
}

.list-chip__icon {
    margin-right: 10px;
    font-size: 18px;
}

.list-chip__title {
    font-size: 14px;
    -unity-font-style: bold;
    color: var(--color-text);
}

.list-chip__sub {
    font-size: 11px;
    color: var(--color-text-muted);
}

.list-chip__store-btn {
    background-color: var(--color-good);
    border-width: 0;
    border-radius: 6px;
    color: rgb(10, 42, 26);
    -unity-font-style: bold;
    font-size: 11px;
    padding: 6px 12px;
    margin-left: 12px;
    -unity-text-align: middle-center;
}

.list-chip__store-btn:hover {
    background-color: var(--color-good-dark);
}

.edit-panel {
    background-color: var(--color-panel-bg);
    border-width: 1px;
    border-color: var(--color-border);
    border-radius: 12px;
    padding: 28px;
    margin-bottom: 28px;
}

.edit-panel__title {
    font-size: 18px;
    -unity-font-style: bold;
    color: var(--color-accent);
    margin-bottom: 20px;
}

.edit-block {
    margin-bottom: 20px;
}
